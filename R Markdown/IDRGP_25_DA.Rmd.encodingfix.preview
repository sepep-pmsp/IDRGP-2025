# AnÃƒÂ¡lises por ano (2022Ã¢â‚¬â€œ2025)

Nesta seÃƒÂ§ÃƒÂ£o, para **cada ano** nÃƒÂ³s geramos:

1) **RegionalizaÃƒÂ§ÃƒÂ£o por aÃƒÂ§ÃƒÂ£o (projeto/atividade)**  
2) **IDRGP Real vs IDRGP Alvo** (teste KS + t pareado/Wilcoxon + classificaÃƒÂ§ÃƒÂ£o por IC 95%)

## FunÃƒÂ§ÃƒÂµes (IDRGP por ano)

```{r funcoes_idrgp_por_ano}
testar_idrgp <- function(df_base) {
  df_teste <- df_base |>
    st_drop_geometry() |>
    select(subprefeitura, valor, idrgp_alvo, idrgp_real, idrgp_diferenca, idrgp_var_percentual) |>
    filter(!is.na(idrgp_diferenca))

  vetor_dif_z <- scale(df_teste$idrgp_diferenca)[, 1]
  teste_ks <- ks.test(vetor_dif_z, "pnorm")

  if (teste_ks$p.value <= 0.05) {
    metodo <- "wilcoxon"
    teste_principal <- wilcox.test(
      df_teste$idrgp_real, df_teste$idrgp_alvo,
      paired = TRUE, conf.int = TRUE, conf.level = 0.95, exact = FALSE
    )
    medida_central <- median(df_teste$idrgp_diferenca, na.rm = TRUE)
  } else {
    metodo <- "t_pareado"
    teste_principal <- t.test(
      df_teste$idrgp_real, df_teste$idrgp_alvo,
      paired = TRUE, conf.level = 0.95
    )
    medida_central <- unname(teste_principal$estimate)
  }

  ic_inf <- teste_principal$conf.int[1]
  ic_sup <- teste_principal$conf.int[2]

  df_teste <- df_teste |>
    mutate(
      status_var_percentual = case_when(
        idrgp_var_percentual >  0.3  ~ "Acima do IDRGP Alvo",
        idrgp_var_percentual < -0.3  ~ "Abaixo do IDRGP Alvo",
        TRUE                         ~ "Dentro do IDRGP Alvo"
      ),
      status_estatistico = case_when(
        idrgp_diferenca < ic_inf ~ "Abaixo do IDRGP Alvo",
        idrgp_diferenca > ic_sup ~ "Acima do IDRGP Alvo",
        TRUE                     ~ "Dentro do IDRGP Alvo"
      )
    )

  list(
    df_teste = df_teste,
    teste_ks = teste_ks,
    teste_principal = teste_principal,
    metodo = metodo,
    medida_central = medida_central,
    ic_inf = ic_inf,
    ic_sup = ic_sup
  )
}

integrar_idrgp_ano <- function(df_agr_ano, ano_ref, subprefeitura_sf, df_idrgp) {
  df_agr_k <- df_agr_ano |>
    mutate(
      subprefeitura = str_squish(subprefeitura),
      join_key = norm_name(subprefeitura)
    )

  df_integrado <- subprefeitura_sf |>
    left_join(df_idrgp |> select(join_key, idrgp_alvo), by = "join_key") |>
    left_join(df_agr_k  |> select(join_key, valor),     by = "join_key") |>
    mutate(
      valor = replace_na(valor, 0),
      idrgp_alvo = replace_na(idrgp_alvo, 0)
    )

  total_valor <- sum(df_integrado$valor, na.rm = TRUE)

  df_integrado <- df_integrado |>
    mutate(
      ano = as.integer(ano_ref),
      idrgp_real      = if (total_valor > 0) valor / total_valor else NA_real_,
      idrgp_diferenca = idrgp_real - idrgp_alvo,
      idrgp_var_percentual = if_else(idrgp_alvo == 0, 0, idrgp_diferenca / idrgp_alvo),
      valor_previsto  = total_valor * idrgp_alvo,
      status_valor    = if_else(valor < valor_previsto,
                                "Valor previsto (R$) nao atingido",
                                "Valor previsto (R$) superado")
    )

  testes <- testar_idrgp(df_integrado)

  df_integrado <- df_integrado |>
    left_join(
      testes$df_teste |> select(subprefeitura, status_var_percentual, status_estatistico),
      by = "subprefeitura"
    )

  list(
    ano = as.integer(ano_ref),
    df_integrado = df_integrado,
    df_teste = testes$df_teste,
    total_valor = total_valor,
    teste_ks = testes$teste_ks,
    teste_principal = testes$teste_principal,
    metodo = testes$metodo,
    medida_central = testes$medida_central,
    ic_inf = testes$ic_inf,
    ic_sup = testes$ic_sup
  )
}
```

## PreparaÃƒÂ§ÃƒÂ£o (gera tudo em listas)

Este chunk faz o Ã¢â‚¬Å“trabalho pesadoÃ¢â‚¬Â uma ÃƒÂºnica vez e guarda tudo em listas fÃƒÂ¡ceis de usar.

```{r prepara_listas, message=FALSE, warning=FALSE}
# 1) RegionalizaÃƒÂ§ÃƒÂ£o por aÃƒÂ§ÃƒÂ£o, por ano
df_reg <- purrr::imap_dfr(arquivos, function(arq, ano_chr) {
  ano <- as.integer(ano_chr)
  aba <- detectar_sheet(arq, ano)
  resumo_regionalizacao(arq, ano, aba)
})

reg_por_ano <- split(df_reg, df_reg$ano)

# 2) IDRGP por ano (teste + classificaÃƒÂ§ÃƒÂ£o)
idrgp_por_ano <- purrr::imap(agrs_25_DA, function(df_agr_ano, ano_chr) {
  integrar_idrgp_ano(df_agr_ano, as.integer(ano_chr), subprefeitura_sf, df_idrgp)
})

# (Opcional) expÃƒÂµe variÃƒÂ¡veis Ã¢â‚¬Å“amigÃƒÂ¡veisÃ¢â‚¬Â no ambiente: idrgp_2022, idrgp_2023...
purrr::iwalk(idrgp_por_ano, function(res, ano_chr) {
  assign(paste0("idrgp_", ano_chr), res, envir = .GlobalEnv)
})
```

## (NOVO) AÃƒÂ§ÃƒÂµes com regionalizaÃƒÂ§ÃƒÂ£o > 70% (2025) Ã¢â‚¬â€ recorte `25_DA`

Este bloco **reutiliza** a tabela anual de regionalizaÃƒÂ§ÃƒÂ£o por aÃƒÂ§ÃƒÂ£o jÃƒÂ¡ calculada (`reg_por_ano`),
sem recalcular bases. O objetivo ÃƒÂ© isolar apenas as acoes cujo percentual de regionalizaÃƒÂ§ÃƒÂ£o
seja superior a **70%** em 2025 e exportar uma tabela rastreÃƒÂ¡vel.

```{r acoes_regionalizacao_maior_70_2025_25_DA, echo=FALSE, message=FALSE, warning=FALSE}
# ============================================================================
# 1) Tabela filtrada (2025) Ã¢â‚¬â€ percentual de regionalizaÃƒÂ§ÃƒÂ£o > 70%
# ============================================================================

df_reg_2025_base_25_DA <- NULL

# 1) Preferencia: `reg_por_ano[["2025"]]` (quando o split inclui o ano)
if (exists("reg_por_ano")) {
  df_reg_2025_base_25_DA <- reg_por_ano[[as.character(2025)]]
}

# 2) Fallback: filtra direto de `df_reg` (quando o split nao gerou a chave)
if (is.null(df_reg_2025_base_25_DA) && exists("df_reg")) {
  df_reg_2025_base_25_DA <- df_reg |>
    dplyr::filter(as.integer(ano) == 2025)
}

# 3) ÃƒÅ¡ltimo fallback: recalcula SOMENTE 2025 (sem afetar os demais objetos)
if (is.null(df_reg_2025_base_25_DA) || nrow(df_reg_2025_base_25_DA) == 0) {
  cat("Ã¢Å¡Â Ã¯Â¸Â `reg_por_ano[['2025']]` nao disponÃƒÂ­vel/sem linhas; recalculando resumo de regionalizaÃƒÂ§ÃƒÂ£o apenas para 2025.\n")
  aba_2025 <- detectar_sheet(arquivo_2025, 2025)
  df_reg_2025_base_25_DA <- resumo_regionalizacao(arquivo_2025, 2025, aba_2025)
}

if (is.null(df_reg_2025_base_25_DA) || nrow(df_reg_2025_base_25_DA) == 0) {
  stop("NÃƒÂ£o foi possÃƒÂ­vel obter a tabela de regionalizaÃƒÂ§ÃƒÂ£o por aÃƒÂ§ÃƒÂ£o para 2025 (25_DA).")
}

df_reg_2025_tratada_25_DA <- df_reg_2025_base_25_DA |>
  dplyr::mutate(
    descricao_proj_ativ = as.character(descricao_proj_ativ),
    .desc = iconv(descricao_proj_ativ, from = "", to = "UTF-8", sub = ""),
    .desc = stringr::str_replace_all(.desc, "[\u00a0\u200b\u200c\u200d\u200e\u200f\ufeff]", " "),
    .desc = stringr::str_squish(.desc),
    .m = stringr::str_match(
      .desc,
      paste0("^\\s*([0-9]{3,8})\\s*", regex_separador_codigo_acao_25_DA, "\\s*(.*)$")
    ),
    codigo_acao = padronizar_codigo_acao_25_DA(.m[, 2]),
    acao = padronizar_acao_texto_25_DA(.m[, 3]),
    percentual_regionalizacao = as.numeric(perc_regionalizado),
    valor_liquidado = as.numeric(valor_total),
    quantidade_subprefeituras_atendidas = as.integer(n_subpref),
    classificacao_territorial_25_DA = dplyr::case_when(
      percentual_regionalizacao > 0.70 ~ "acima_70pct",
      TRUE ~ "ate_70pct"
    )
  ) |>
  dplyr::select(
    ano,
    codigo_acao,
    acao,
    percentual_regionalizacao,
    valor_liquidado,
    valor_regionalizado,
    quantidade_subprefeituras_atendidas,
    classificacao_territorial_25_DA,
    descricao_proj_ativ,
    dplyr::everything()
  ) |>
  dplyr::filter(!is.na(percentual_regionalizacao))

acoes_regionalizacao_maior_70_2025_25_DA <- df_reg_2025_tratada_25_DA |>
  dplyr::filter(percentual_regionalizacao > 0.70) |>
  dplyr::arrange(dplyr::desc(percentual_regionalizacao), dplyr::desc(valor_liquidado)) |>
  dplyr::mutate(
    percentual_regionalizacao = round(percentual_regionalizacao, 4),
    valor_liquidado = round(valor_liquidado, 2),
    valor_regionalizado = round(as.numeric(valor_regionalizado), 2)
  )

arq_xlsx_25_DA <- file.path(pasta_saida, "tabelas_25_DA", "acoes_regionalizacao_maior_70_2025_25_DA.xlsx")
arq_csv_25_DA <- file.path(pasta_saida, "tabelas_25_DA", "acoes_regionalizacao_maior_70_2025_25_DA.csv")

writexl::write_xlsx(acoes_regionalizacao_maior_70_2025_25_DA, path = arq_xlsx_25_DA)
readr::write_csv(acoes_regionalizacao_maior_70_2025_25_DA, file = arq_csv_25_DA)

cat("Ã¢Å“â€¦ Exportado: ", arq_xlsx_25_DA, "\n", sep = "")
cat("Ã¢Å“â€¦ Exportado: ", arq_csv_25_DA, "\n", sep = "")
```

