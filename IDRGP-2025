# 7. Construção dos Indicadores do IDRGP

Os indicadores do IDRGP são calculados a partir da relação entre vulnerabilidade territorial e execução orçamentária regionalizada.

A metodologia considera dois eixos principais:

Distribuição Esperada: proporção estimada de recursos segundo os indicadores de vulnerabilidade urbana;
Distribuição Realizada: participação efetiva dos gastos liquidados em cada subprefeitura.

As análises são realizadas em duas escalas:

Ano de referência (2025);
Acumulado do ciclo do PPA (2022–2025).

Também são aplicados procedimentos estatísticos de apoio à interpretação dos resultados territoriais e sua visualização.

```{r indicadores, message=FALSE, warning=FALSE}
df_idrgp_2025 <- dados_base |>
  filter(ano_empenho == 2025) |>
  group_by(subprefeitura, sigla, join_key) |>
  summarise(valor_executado = sum(valor, na.rm = TRUE), .groups = "drop") |>
  mutate(total_municipio = sum(valor_executado, na.rm = TRUE)) |>
  left_join(ivu_df |> select(join_key, ivu), by = "join_key") |>
  mutate(
    idrgp_alvo = ivu / sum(ivu, na.rm = TRUE),
    idrgp_real = valor_executado / total_municipio,
    diferenca = idrgp_real - idrgp_alvo,
    valor_previsto = idrgp_alvo * total_municipio,
    status_valor = if_else(valor_executado >= valor_previsto, "Valor previsto (R$) superado", "Valor previsto (R$) não atingido")
  )

teste_ks_25 <- ks.test(scale(df_idrgp_2025$diferenca)[,1], "pnorm")
if (teste_ks_25$p.value <= 0.05) {
  teste_25 <- wilcox.test(df_idrgp_2025$idrgp_real, df_idrgp_2025$idrgp_alvo, paired = TRUE, conf.int = TRUE)
} else {
  teste_25 <- t.test(df_idrgp_2025$idrgp_real, df_idrgp_2025$idrgp_alvo, paired = TRUE)
}

ic_inf_25 <- teste_25$conf.int[1]
ic_sup_25 <- teste_25$conf.int[2]

df_idrgp_2025 <- df_idrgp_2025 |>
  mutate(
    status_estatistico = case_when(
      diferenca < ic_inf_25 ~ "Abaixo do IDRGP Alvo",
      diferenca > ic_sup_25 ~ "Acima do IDRGP Alvo",
      TRUE ~ "Dentro do IDRGP Alvo"
    ),
    status_estatistico = factor(status_estatistico, levels = names(cores_status))
  )

df_ciclo <- dados_base |>
  group_by(subprefeitura, sigla, join_key) |>
  summarise(valor_acumulado = sum(valor, na.rm = TRUE), .groups = "drop") |>
  mutate(total_municipio = sum(valor_acumulado, na.rm = TRUE)) |>
  left_join(ivu_df |> select(join_key, ivu), by = "join_key") |>
  mutate(
    idrgp_alvo = ivu / sum(ivu, na.rm = TRUE),
    idrgp_real_ciclo = valor_acumulado / total_municipio,
    diferenca_ciclo = idrgp_real_ciclo - idrgp_alvo
  )

ggplot(
  df_idrgp_2025 |> 
    arrange(diferenca) |> 
    mutate(subprefeitura = forcats::fct_reorder(subprefeitura, diferenca)),
  aes(x = subprefeitura, y = diferenca, fill = status_estatistico)
) +
  geom_col() +
  coord_flip() +
  scale_fill_manual(values = cores_status) +
  labs(
    title = "Diferença entre IDRGP Realizado e IDRGP Alvo (2025)",
    subtitle = "Distribuição regionalizada do gasto público por subprefeitura",
    x = NULL,
    y = "Diferença (Realizado - Alvo)",
    fill = "Status"
  ) +
  theme_minimal(base_size = 12)

```

#8. Análises Territoriais e Série Histórica

Nesta fase são organizadas as bases históricas utilizadas para acompanhar a evolução territorial da execução orçamentária ao longo do ciclo do PPA.

A estrutura analítica permite:

Comparar o comportamento dos investimentos entre anos;
Identificar tendências territoriais;
Avaliar mudanças na distribuição regional do gasto público;
Produzir séries históricas por subprefeitura.

Os dados são preparados em formato adequado para visualizações comparativas e análises longitudinais.

```{r serie_historica}
df_longo <- dados_base |>
  group_by(ano_empenho, subprefeitura, sigla, join_key) |>
  summarise(valor_ano = sum(valor, na.rm = TRUE), .groups = "drop") |>
  left_join(ivu_df |> select(join_key, ivu), by = "join_key") |>
  mutate(
    idrgp_alvo = ivu / sum(ivu, na.rm = TRUE),
        ano_empenho = factor(ano_empenho, levels = c("2025", "2024", "2023", "2022")) 
  )

ggplot( df_longo, aes( x = ano_empenho, y = valor_ano, group = subprefeitura, color = subprefeitura ) ) + geom_line(linewidth = 1) + geom_point(size = 2) + scale_y_continuous(labels = scales::label_number(big.mark = ".", decimal.mark = ",")) + labs( title = "Série Histórica da Execução Orçamentária Regionalizada", subtitle = "Valores agregados por subprefeitura no ciclo do PPA 2022–2025", x = "Ano", y = "Valor Executado (R$)", color = "Subprefeitura" ) + theme_minimal(base_size = 12) + theme( legend.position = "none", plot.title = element_text(face = "bold") )

```

